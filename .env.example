# ── API Keys ──────────────────────────────────────────────────────────────────
NEWS_API_KEY=
# Get yours free at https://open-platform.theguardian.com/access/
GUARDIAN_API_KEY=

# Firebase Cloud Messaging (optional - for push notifications)
# Get from Firebase Console → Project Settings → Cloud Messaging → Server Key
FCM_SERVER_KEY=your_fcm_server_key_here

# ── Security ──────────────────────────────────────────────────────────────────
# CHANGE THIS in production! Use a long random string (32+ chars)
JWT_SECRET=
